  <Flow>
    <Routine name="指导语"/>
    <LoopInitiator loopType="TrialHandler" name="blocks">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'block_loop': 'block1.xlsx', 'reps': 3, 'leftLabel': '积极词-按E键', 'rightLabel': '消极词-按I键', 'InstrText': '接下来将进行第一部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n一会屏幕中会先短暂出现一个十字，请注视。\n十字消失后会出现一个词语（积极词或消极词），\n请在保证正确率的前提下快速对其进行分类。\n具体规则为：积极词-按E键；消极词-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}, {'block_loop': 'block2.xlsx', 'reps': 3, 'leftLabel': '花-按E键', 'rightLabel': '虫-按I键', 'InstrText': '接下来将进行第二部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n该部分流程与刚才相同，只是出现的词语和规则稍有变化\n词语为花或者虫\n具体规则为：花-按E键；虫-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}, {'block_loop': 'block34.xlsx', 'reps': 2, 'leftLabel': '积极词或花-按E键', 'rightLabel': '消极词或虫-按I键', 'InstrText': '接下来将进行第三部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n该部分流程与刚才相同，只是前两部分的词语都会出现\n具体规则为：积极词或花-按E键；消极词或虫-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}, {'block_loop': 'block34.xlsx', 'reps': 4, 'leftLabel': '积极词或花-按E键', 'rightLabel': '消极词或虫-按I键', 'InstrText': '接下来将进行第四部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n该部分与第三部分完全相同，没有变化\n具体规则为：积极词或花-按E键；消极词或虫-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}, {'block_loop': 'block5.xlsx', 'reps': 3, 'leftLabel': '虫词-按E键', 'rightLabel': '花词-按I键', 'InstrText': '接下来将进行第五部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n该部分出现的词语只有花或虫，但是调换了按键\n具体规则为：虫-按E键；花-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}, {'block_loop': 'block67.xlsx', 'reps': 2, 'leftLabel': '积极词或虫-按E键', 'rightLabel': '消极词或花-按I键', 'InstrText': '接下来将进行第六部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n该部分中，所有词语都会出现。\n具体规则为：积极词或虫-按E键；消极词或花-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}, {'block_loop': 'block67.xlsx', 'reps': 4, 'leftLabel': '积极词或虫-按E键', 'rightLabel': '消极词或花-按I键', 'InstrText': '接下来将进行第七部分的测试\n请你将左手和右手的食指分别放在E和I按键上。\n该部分与第六部分完全相同，没有变化\n具体规则为：积极词或虫-按E键；消极词或花-按I键\n如果你已经明白规则，请按空格键开始测试\n如果你有任何疑问，请咨询实验员'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="IAT_block_loop.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="blocks" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Block指导语"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$block_loop" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="reps" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
    <Routine name="Block结束语"/>
    <LoopTerminator name="blocks"/>
    <Routine name="结束语"/>
  </Flow>
</PsychoPy2experiment>
